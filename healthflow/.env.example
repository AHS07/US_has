# HealthFlow — environment variable template
# Copy this file to .env and fill in the values.
# .env is git-ignored; .env.example is committed.

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=healthflow
POSTGRES_USER=healthflow
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# DB 0 = slot-hold counters + general cache
# DB 1 = Celery broker (set automatically via CELERY_BROKER_URL in settings)

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=healthflow

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
SENDGRID_API_KEY=SG.change-me
DEFAULT_FROM_EMAIL=noreply@healthflow.local

# ── LLM (Azure OpenAI or compatible zero-retention endpoint) ─────────────────
# NOTE: patient symptom text must never transit a consumer-tier API.
# Use Azure OpenAI, AWS Bedrock, or a self-hosted model with a DPA in prod.
LLM_API_BASE=https://your-resource.openai.azure.com/
LLM_API_KEY=change-me
LLM_MODEL=gpt-4o
LLM_API_VERSION=2024-02-01

# ── Google Calendar OAuth2 ────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=change-me
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/admin-api/doctors/google/callback

# ── Encryption (Fernet key for OAuth token storage at rest) ──────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-fernet-key

# ── Booking ───────────────────────────────────────────────────────────────────
SLOT_HOLD_TTL_SECONDS=600
